{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diagforge.dev/schemas/report-v1.json",
  "title": "DiagForge Diagnostic Evidence Report",
  "description": "Structured output of a DiagForge analysis run. One report per analysis invocation, containing one or more DTC analysis entries with hypotheses, mitigations, and provenance.",
  "type": "object",
  "required": ["report_id", "schema_version", "created_at", "input", "analyses", "tool"],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "diagforge" },
        "version": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "required": ["trace_file", "dtc_file"],
      "properties": {
        "trace_file": {
          "type": "object",
          "required": ["path", "format", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "format": { "enum": ["asc", "blf", "log", "csv"] },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "duration_us": { "type": "integer" },
            "event_count": { "type": "integer" }
          }
        },
        "dtc_file": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "dtc_count": { "type": "integer" }
          }
        },
        "dbc_file": {
          "type": "object",
          "description": "Optional - DBC for signal decoding",
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "analyses": {
      "type": "array",
      "items": { "$ref": "#/$defs/dtcAnalysis" }
    }
  },
  "$defs": {
    "dtcAnalysis": {
      "type": "object",
      "required": ["dtc", "pattern_features", "diagnostic_result", "mitigation_matches"],
      "properties": {
        "dtc": {
          "type": "object",
          "required": ["code", "standard"],
          "properties": {
            "code": { "type": "string", "examples": ["P0420", "U0100", "1A2B"] },
            "standard": { "enum": ["obd2", "uds", "j1939"] },
            "status_byte": { "type": "integer", "minimum": 0, "maximum": 255 },
            "occurrence_count": { "type": "integer", "minimum": 1 },
            "first_seen_us": { "type": "integer" },
            "last_seen_us": { "type": "integer" },
            "description": { "type": "string" }
          }
        },
        "pattern_features": {
          "type": "object",
          "required": ["window_us", "notable_findings"],
          "properties": {
            "window_us": { "type": "integer" },
            "signal_summaries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["signal_name", "transition_rate_hz", "interval_stats"],
                "properties": {
                  "signal_name": { "type": "string" },
                  "transition_rate_hz": { "type": "number" },
                  "interval_stats": {
                    "type": "object",
                    "properties": {
                      "mean_us": { "type": "number" },
                      "median_us": { "type": "number" },
                      "p99_us": { "type": "number" }
                    }
                  }
                }
              }
            },
            "transition_anomalies": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["signal_name", "anomaly_type", "description"],
                "properties": {
                  "signal_name": { "type": "string" },
                  "anomaly_type": {
                    "enum": [
                      "debounce_candidate",
                      "power_cycle_burst",
                      "signal_dropout",
                      "value_spike",
                      "communication_gap"
                    ]
                  },
                  "description": { "type": "string" },
                  "evidence_us": { "type": "array", "items": { "type": "integer" } }
                }
              }
            },
            "correlations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "signal_a": { "type": "string" },
                  "signal_b": { "type": "string" },
                  "lag_us": { "type": "integer" },
                  "correlation_coefficient": { "type": "number", "minimum": -1, "maximum": 1 }
                }
              }
            },
            "notable_findings": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Short human-readable strings the diagnostic agent must cite verbatim as evidence."
            }
          }
        },
        "diagnostic_result": {
          "type": "object",
          "required": ["hypotheses", "model", "model_version", "prompt_template_version"],
          "properties": {
            "model": { "type": "string", "examples": ["claude-sonnet-4-6"] },
            "model_version": { "type": "string" },
            "prompt_template_version": { "type": "string" },
            "prompt_hash": { "type": "string" },
            "hypotheses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rank", "description", "confidence", "evidence", "reasoning"],
                "properties": {
                  "rank": { "type": "integer", "minimum": 1 },
                  "description": { "type": "string" },
                  "confidence": { "enum": ["low", "medium", "high"] },
                  "evidence": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Quoted verbatim from pattern_features.notable_findings"
                  },
                  "suggested_pattern_id": { "type": ["string", "null"] },
                  "reasoning": { "type": "string" }
                }
              }
            }
          }
        },
        "mitigation_matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern_id", "pattern_name", "parameter_suggestions", "verification_steps"],
            "properties": {
              "pattern_id": { "type": "string" },
              "pattern_name": { "type": "string" },
              "parameter_suggestions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "suggested_value": { "type": ["string", "number"] },
                    "rationale": { "type": "string" }
                  }
                }
              },
              "verification_steps": { "type": "array", "items": { "type": "string" } },
              "standards_references": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
